direction: down

# ── Left: two rows stacked vertically ────────────────────────────────
PFS-input: {
  direction: down

  # Row 1 ──────────────────────────────────────────────────────────────
  Client-flow: {
    direction: right

    client_db: |md
      ## Client Database
      - Age
      - Gender
      - Married
      - Tax Residence
      - Income
      - Investment goals (TBD)
      - Holdings
    |
    client_db.shape: stored_data

    irs: |md
      ## Investor Readiness Scorecard
      - % Cash or equivalents
      - Concentration Risk
      - Investment experience
      - Life stage (Number of potential needs)
    |
    irs.shape: step
    irs.style.fill: linen

    potential_client: |md
      ## Top-n Selected Clients
      - Readiness Score
    |
    potential_client.shape: document

    client_db -> irs -> potential_client
  }

  # Row 2 ──────────────────────────────────────────────────────────────
  Product-flow: {
    direction: down

    product_db: |md
      ## Products Catalog
      - Asset class
      - Risk rating
      - Liquidity
      - Historical performance
          - Expected return
          - Volatility
          - Max drawdown
      - Complexity and other risk metrics
      - Natural language comment
    |
    product_db.shape: stored_data

    selected_products: |md
      ## Selected Products (Manual)
      - RM select on UI
      - Bank's promotion
      - Top selling products
    |
    selected_products.shape: document

    product_db -> selected_products
  }
}

# ── Right: Product-Client Matcher ────────────────────────────────────
pc_matcher: AI-assist product-client matcher {
  direction: down

  market: |md
    # Market Outlook
    - Bank's research
    - News and market sentiment
  |
  market.shape: document

  # ── Main vertical chain ─────────────────────────────────────────────
  pfs: |md
    ## Product Fitness Scorecard
    - Risk rating
    - Incremental concentration risk
    - Better product than current holding
    - Investment experience
  |
  pfs.shape: step
  pfs.style.fill: linen

  matching_scores: |md
    ## Matching Scores
    - (client1, product1, score 1)
    - (client1, product2, score 2)
    - (client2, product1, score 3)
  |
  matching_scores.shape: document

  llm: |md
    ## AI Product Investor Matcher
    Consideration mainly on natural language input
    - The product/investor fitness score
    - Market outlook
    - Client profile
    - Product catalog
    - Compose proposal with natural language
    - Scenario analysis
  |
  llm.shape: rectangle

  scenario: |md
    # Scenario Analysis Engine
    - Selected historical period
  |
  scenario.shape: rectangle

  proposal_writer: |md
    ## AI Proposal Writer
    - Executive summary
    - Suggested product & funding
    - Rationale of the suggestion
    - Pros and cons regarding from portfolio perspective
    - Scenario analysis
    - Alternative suggestions
    - Risk disclosure
  |
  proposal_writer.shape: rectangle

  pfs -> matching_scores -> llm -> proposal_writer
  market -> llm
  scenario -> proposal_writer
}

# ── Cross-panel connections ─────────────────────────────────────────
PFS-input.client-flow.potential_client -> pc_matcher.pfs
PFS-input.product-flow.selected_products -> pc_matcher.pfs
