  "paths": {
    "/api/v1/clients": {
      "get": {
        "summary": "List Clients",
        "description": "List raw client rows.\n\n``client_id`` accepts a **comma-separated** list to fetch multiple clients\nin one call.  Example: `?client_id=PB-HK-000007-5,PB-HK-000002-6`",
        "operationId": "list_clients_api_v1_clients_get",
        "parameters": [
          {
            "name": "client_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated list of client IDs to filter by (e.g. `PB-HK-000007-5,PB-HK-000002-6`). Omit to return all clients.",
              "title": "Client Id"
            },
            "description": "Comma-separated list of client IDs to filter by (e.g. `PB-HK-000007-5,PB-HK-000002-6`). Omit to return all clients.",
            "examples": {
              "Akira Tanaka (bond holder)": {
                "value": "PB-HK-000007-5"
              },
              "Two clients (comma-separated)": {
                "value": "PB-HK-000007-5,PB-HK-000002-6"
              }
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of rows to skip (0-based).",
              "examples": [
                0
              ],
              "default": 0,
              "title": "Offset"
            },
            "description": "Number of rows to skip (0-based)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum number of rows to return. Omit for all.",
              "examples": [
                10
              ],
              "title": "Limit"
            },
            "description": "Maximum number of rows to return. Omit for all."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClientRow"
                  },
                  "title": "Response List Clients Api V1 Clients Get"
                },
                "example": [
                  {
                    "client_id": "PB-HK-000007-5",
                    "name": "Akira Tanaka",
                    "aum": 28000000.0,
                    "cash_pct": 12.0,
                    "region": "APAC",
                    "birthdate": "1980-01-01",
                    "occupation": "Real Estate Developer",
                    "risk_rating": 4,
                    "marital_status": "Single",
                    "children_info": "2 children",
                    "liquidity_need": "Low",
                    "income_stability": "Stable salaried income",
                    "investment_objective": "Long-term capital growth",
                    "qualitative_profile": "Self-made real estate developer with entrepreneurial mindset. Comfortable with illiquid and alternative investments."
                  }
                ]
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clients/{client_id}": {
      "get": {
        "summary": "Get Client",
        "description": "Return a single raw client row.",
        "operationId": "get_client_api_v1_clients__client_id__get",
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Client identifier.",
              "title": "Client Id"
            },
            "description": "Client identifier.",
            "examples": {
              "Akira Tanaka (bond holder)": {
                "value": "PB-HK-000007-5"
              },
              "Sarah Chen": {
                "value": "PB-HK-000002-6"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientRow"
                },
                "example": {
                  "client_id": "PB-HK-000007-5",
                  "name": "Akira Tanaka",
                  "aum": 28000000.0,
                  "cash_pct": 12.0,
                  "region": "APAC",
                  "birthdate": "1980-01-01",
                  "occupation": "Real Estate Developer",
                  "risk_rating": 4,
                  "marital_status": "Single",
                  "children_info": "2 children",
                  "liquidity_need": "Low",
                  "income_stability": "Stable salaried income",
                  "investment_objective": "Long-term capital growth",
                  "qualitative_profile": "Self-made real estate developer with entrepreneurial mindset. Comfortable with illiquid and alternative investments."
                }
              }
            }
          },
          "404": {
            "description": "Client not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
